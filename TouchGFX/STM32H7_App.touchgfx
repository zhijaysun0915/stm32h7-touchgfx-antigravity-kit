{
  "Application": {
    "Name": "STM32H7_App",
    "TouchGfxPath": "../Middlewares/ST/touchgfx",
    "AvailableColorDepths": [16, 24],
    "AvailableLCDs": {
      "16": "LCD16bpp",
      "24": "LCD24bpp"
    },
    "AvailableResolutions": [
      {
        "Width": 480,
        "Height": 272
      }
    ],
    "Resolution": {
      "Width": 480,
      "Height": 272
    },
    "SelectedColorDepth": 16,
    "StartupScreenName": "DashboardScreen",
    "Screens": [
      {
        "Name": "DashboardScreen",
        "Components": [
          {
            "Type": "Image",
            "Name": "bgImage",
            "X": 0,
            "Y": 0,
            "Width": 480,
            "Height": 272,
            "RelativeFilename": "bg_dashboard.png"
          },
          {
            "Type": "Image",
            "Name": "leftCard",
            "X": 16,
            "Y": 48,
            "Width": 216,
            "Height": 160,
            "RelativeFilename": "card_panel.png"
          },
          {
            "Type": "Image",
            "Name": "rightCard",
            "X": 248,
            "Y": 48,
            "Width": 216,
            "Height": 160,
            "RelativeFilename": "card_panel.png"
          },
          {
            "Type": "TextArea",
            "Name": "titleText",
            "X": 16,
            "Y": 12,
            "Width": 320,
            "Height": 28,
            "TextId": "T_DASHBOARD_TITLE",
            "Color": { "Red": 248, "Green": 250, "Blue": 252 },
            "Wildcard1": {
              "TextId": "T_TEMP_DEFAULT",
              "UseBuffer": true,
              "BufferSize": 16
            }
          },
          {
            "Type": "BoxProgress",
            "Name": "loadBar",
            "X": 34,
            "Y": 160,
            "Width": 180,
            "Height": 14,
            "Color": { "Red": 56, "Green": 189, "Blue": 248 },
            "FileNameBackground": "progress_bg.png",
            "ProgressRangeMin": 0,
            "ProgressRangeMax": 100,
            "ProgressInitialValue": 64
          },
          {
            "Type": "ButtonWithLabel",
            "Name": "btnBoost",
            "X": 264,
            "Y": 104,
            "Width": 184,
            "Height": 42,
            "Pressed": "btn_action_pressed.png",
            "Released": "btn_action_released.png",
            "TextId": "T_BTN_BOOST",
            "ReleasedColor": { "Red": 255, "Green": 255, "Blue": 255 },
            "PressedColor": { "Red": 220, "Green": 252, "Blue": 231 }
          },
          {
            "Type": "ButtonWithLabel",
            "Name": "btnNextScreen",
            "X": 340,
            "Y": 220,
            "Width": 124,
            "Height": 40,
            "Pressed": "btn_primary_pressed.png",
            "Released": "btn_primary_released.png",
            "TextId": "T_BTN_SETTINGS",
            "ReleasedColor": { "Red": 255, "Green": 255, "Blue": 255 },
            "PressedColor": { "Red": 186, "Green": 230, "Blue": 253 }
          }
        ],
        "Interactions": [
          {
            "InteractionName": "OnBoostClicked",
            "Trigger": {
              "Type": "TriggerClicked",
              "TriggerComponent": "btnBoost"
            },
            "Action": {
              "Type": "ActionCustom",
              "FunctionName": "handleBoostClicked"
            }
          },
          {
            "InteractionName": "OnGotoSettings",
            "Trigger": {
              "Type": "TriggerClicked",
              "TriggerComponent": "btnNextScreen"
            },
            "Action": {
              "Type": "ActionGotoScreen",
              "ScreenTransitionType": "ScreenTransitionSlide",
              "ScreenTransitionDirection": "East",
              "ActionComponent": "SettingsScreen"
            }
          }
        ]
      },
      {
        "Name": "SettingsScreen",
        "Components": [
          {
            "Type": "Box",
            "Name": "settingsBg",
            "X": 0,
            "Y": 0,
            "Width": 480,
            "Height": 272,
            "Color": { "Red": 15, "Green": 23, "Blue": 42 }
          },
          {
            "Type": "TextArea",
            "Name": "settingsTitle",
            "X": 20,
            "Y": 16,
            "Width": 300,
            "Height": 28,
            "TextId": "T_SETTINGS_TITLE",
            "Color": { "Red": 248, "Green": 250, "Blue": 252 }
          },
          {
            "Type": "ButtonWithLabel",
            "Name": "btnBack",
            "X": 16,
            "Y": 220,
            "Width": 124,
            "Height": 40,
            "Pressed": "btn_primary_pressed.png",
            "Released": "btn_primary_released.png",
            "TextId": "T_BTN_BACK",
            "ReleasedColor": { "Red": 255, "Green": 255, "Blue": 255 },
            "PressedColor": { "Red": 186, "Green": 230, "Blue": 253 }
          }
        ],
        "Interactions": [
          {
            "InteractionName": "OnBackToDashboard",
            "Trigger": {
              "Type": "TriggerClicked",
              "TriggerComponent": "btnBack"
            },
            "Action": {
              "Type": "ActionGotoScreen",
              "ScreenTransitionType": "ScreenTransitionSlide",
              "ScreenTransitionDirection": "West",
              "ActionComponent": "DashboardScreen"
            }
          }
        ]
      }
    ],
    "CustomContainerDefinitions": [],
    "GenerateAssetsCommand": "python3 ../execution/tgfx_codegen.py -p STM32H7_App.touchgfx",
    "PostGenerateCommand": "true",
    "Family": "STM32H7",
    "SubFamily": "STM32H745/755",
    "Platform": "m7",
    "ProjectFile": "../CMakeLists.txt"
  }
}
